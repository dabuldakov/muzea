<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Нео-брутализм: тёмный фон, фиолетовый акцент, чёрные контуры. -->
    <style name="Theme.Muzea" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_200</item>
        <item name="colorSecondaryVariant">@color/purple_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_muted</item>

        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/app_background</item>

        <item name="materialButtonStyle">@style/Widget.Muzea.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Muzea.CardView</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Muzea.Dialog</item>
    </style>

    <!-- Кнопки: фиолетовая заливка, чёрный контур 3dp, прямые углы. -->
    <style name="Widget.Muzea.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="strokeWidth">3dp</item>
        <item name="strokeColor">@color/neon_outline</item>
        <item name="cornerRadius">0dp</item>
    </style>

    <style name="Widget.Muzea.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeWidth">3dp</item>
        <item name="strokeColor">@color/neon_outline</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="ThemeOverlay.Muzea.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Muzea.Dialog</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>

    <style name="ShapeAppearance.Muzea.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Прозрачная тема для приёмника «Поделиться». -->
    <style name="Theme.Muzea.Transparent" parent="Theme.Muzea">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="ThemeOverlay.Design.TextInputEditText" parent="">
        <item name="colorControlNormal">@color/purple_500</item>
        <item name="colorControlActivated">@color/purple_200</item>
        <item name="colorControlHighlight">@color/purple_200</item>
    </style>
</resources>
