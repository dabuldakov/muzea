<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Общий стиль экранов входа, регистрации и подтверждения кода. -->

    <style name="Widget.Muzea.AuthBrand" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/auth_ink</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Widget.Muzea.AuthTagline" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/auth_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Muzea.AuthCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/auth_card</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/auth_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Muzea.AuthTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/auth_ink</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Muzea.AuthCaption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/auth_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Muzea.AuthInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/auth_input_stroke_selector</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/auth_purple</item>
        <item name="android:textColorHint">@color/auth_muted</item>
    </style>

    <style name="Widget.Muzea.AuthButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/auth_purple</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Muzea.AuthLink" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">6dp</item>
        <item name="android:textColor">@color/auth_purple</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Muzea.AuthCheckBox" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/auth_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="buttonTint">@color/auth_purple</item>
    </style>

    <style name="Theme.Muzea.Auth" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/auth_purple</item>
        <item name="colorPrimaryVariant">@color/auth_purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/auth_pink</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/Widget.Muzea.AuthButton</item>
        <item name="materialCardViewStyle">@style/Widget.Muzea.AuthCard</item>
    </style>
</resources>
