<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.example.muzea.ui.auth.AuthWavesView
        android:id="@+id/authWaves"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Widget.Muzea.AuthBrand"
                android:layout_gravity="center_horizontal"
                android:text="@string/app_name" />

            <TextView
                style="@style/Widget.Muzea.AuthTagline"
                android:layout_gravity="center_horizontal"
                android:text="@string/login_subtitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Muzea.AuthCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvLoginTitle"
                        style="@style/Widget.Muzea.AuthTitle"
                        android:text="@string/login_title" />

                    <TextView
                        android:id="@+id/tvLoginCaption"
                        style="@style/Widget.Muzea.AuthCaption"
                        android:text="@string/login_caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Muzea.AuthInput"
                        android:layout_marginTop="20dp"
                        android:hint="@string/hint_email">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionGo"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="@color/auth_ink" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Widget.Muzea.AuthButton"
                        android:layout_marginTop="20dp"
                        android:text="@string/action_get_code" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/auth_purple"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRegister"
                        style="@style/Widget.Muzea.AuthLink"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:text="@string/login_no_account" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvLegalNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:alpha="0.9"
                android:text="@string/login_legal_note"
                android:textAlignment="center"
                android:textColor="@color/auth_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLegalTerms"
                    style="@style/Widget.Muzea.AuthLink"
                    android:text="@string/consent_open_terms"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLegalPolicy"
                    style="@style/Widget.Muzea.AuthLink"
                    android:text="@string/consent_open_policy"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
