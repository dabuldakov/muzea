<?xml version="1.0" encoding="utf-8"?>
<!-- Входящее сообщение: графит, чёрный контур 3dp и жёсткая тень 4dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_outline" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="18dp"
                android:bottomRightRadius="18dp"
                android:bottomLeftRadius="18dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bubble_incoming" />
            <stroke android:width="3dp" android:color="@color/neon_outline" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="18dp"
                android:bottomRightRadius="18dp"
                android:bottomLeftRadius="18dp" />
        </shape>
    </item>
</layer-list>
