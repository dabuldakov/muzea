<?xml version="1.0" encoding="utf-8"?>
<!-- Вкладки как одинаковые кнопки: активная — фиолетовая, остальные — тёмные. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:left="7dp" android:top="7dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neon_outline" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/purple_500" />
                    <stroke android:width="2dp" android:color="@color/neon_outline" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <inset xmlns:android="http://schemas.android.com/apk/res/android"
            android:insetLeft="5dp"
            android:insetTop="5dp"
            android:insetRight="5dp"
            android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/surface" />
                <stroke android:width="2dp" android:color="@color/neon_outline" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
</selector>
