<?xml version="1.0" encoding="utf-8"?>
<!-- Своё сообщение: фиолетовый, чёрный контур 3dp, срез правого нижнего угла. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_outline" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="22dp"
                android:bottomRightRadius="4dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/purple_500" />
            <stroke android:width="3dp" android:color="@color/neon_outline" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="22dp"
                android:bottomRightRadius="4dp" />
        </shape>
    </item>
</layer-list>
