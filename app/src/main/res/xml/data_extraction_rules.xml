<?xml version="1.0" encoding="utf-8"?><!--
   Учётные данные (логин, email, пароль, токены) исключены из облачного бэкапа
   и переноса на другое устройство: app_prefs — обычные настройки,
   secure_prefs — шифрованные учётные данные (мастер-ключ в Keystore не переносится).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_prefs.xml"/>
        <exclude domain="sharedpref" path="secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_prefs.xml"/>
        <exclude domain="sharedpref" path="secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
