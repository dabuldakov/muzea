# Параметры ключа подписи release-сборок.
#
# Скопируй файл как keystore.properties (он в .gitignore и в git не попадает)
# и подставь свои значения. Имена те же, что и у переменных окружения, которые
# читает GitHub Actions, — поэтому один и тот же ключ работает и локально,
# и в CI.
#
# ВАЖНО: в MUZEA_KEYSTORE_PATH указывай путь до ФАЙЛА, а не до каталога,
# в котором он лежит. Ошибка здесь не роняет сборку — она молча уходит
# на отладочную подпись. Проверить: ./gradlew :app:signingReport
#
# Тот же ключ нужен, чтобы пользователи могли обновлять приложение поверх
# ранее установленного: смена ключа ломает обновление, придётся удалять
# старую версию.

MUZEA_KEYSTORE_PATH=/home/dmitry/rustore/muzea.jks
MUZEA_KEYSTORE_PASSWORD=пароль_хранилища
MUZEA_KEY_ALIAS=алиас_ключа
MUZEA_KEY_PASSWORD=пароль_ключа

# Если ни этот файл, ни переменные окружения не заданы, release-сборка
# подписывается отладочным ключом — такой APK нельзя будет обновить поверх
# настоящего, и Google Play его не примет.